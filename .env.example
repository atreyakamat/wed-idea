# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_…) or legacy anon key. Safe in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The secret key (sb_secret_…) or legacy service_role key. Server only.
SUPABASE_SECRET_KEY=

# Public URL of this site, used to build guests' gallery links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
