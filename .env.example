# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_…) or legacy anon key. Safe in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The secret key (sb_secret_…) or legacy service_role key. Server only.
SUPABASE_SECRET_KEY=

# Schema isolation (optional): Set to "wed_idea" if you are sharing an existing Supabase
# project with another app and ran `supabase-migration-isolated.sql`.
# Leave empty (or "public") if you ran `supabase-migration-public.sql`.
# NEXT_PUBLIC_SUPABASE_SCHEMA=wed_idea

# Public URL of this site, used to build guests' gallery links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Launch settings (all optional until you launch) ---

# Product name, support email and the legal business name shown in Terms/Privacy.
NEXT_PUBLIC_BRAND_NAME=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_LEGAL_NAME=

# Daily clean-up (see .github/workflows/cleanup.yml). 32+ random characters,
# e.g. `openssl rand -hex 32`. Put the same value in the GitHub secret CRON_SECRET.
CRON_SECRET=

# Error reports to Sentry: the project's DSN (Sentry → Project settings → Client Keys).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Privacy-friendly analytics (Plausible or compatible). Leave empty to turn off.
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_ANALYTICS_SCRIPT=https://plausible.io/js/script.js

# PC app downloads. Default: the latest GitHub release of this repo (made by
# pushing a tag like pc-app-v0.2.0). Set to host the installers elsewhere.
NEXT_PUBLIC_PC_APP_DOWNLOAD_BASE=

# Razorpay (self-serve payment). Test keys (rzp_test_…) work until KYC is
# done; then swap in live keys. Leave empty to keep "Request" only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret you choose in Razorpay → Webhooks (events: payment.captured,
# order.paid; URL: https://<your site>/api/razorpay/webhook).
RAZORPAY_WEBHOOK_SECRET=
